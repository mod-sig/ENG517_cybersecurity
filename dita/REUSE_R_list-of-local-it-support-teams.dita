                <li><xref href="https://design.ncsu.edu/operations/it/" format="html" scope="external">College of Design</xref></li>
                <li><xref href="https://ced.ncsu.edu/about-us/college-resources/edit/" format="html" scope="external">College of Education</xref></li>
